NODE_ENV=development
DEMO_MODE=false
PORT=5001
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/printready?schema=public
JWT_SECRET=
JWT_EXPIRES_IN=1h
FRONTEND_URL=http://localhost:5173
TRUSTED_ORIGINS=http://localhost:5173
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage/private
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional; defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ENDPOINT=
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000
MAX_UPLOAD_BYTES=10485760
MAX_CONCURRENT_PDF_VALIDATIONS=1
USER_STORAGE_QUOTA_BYTES=104857600
FILE_RETENTION_DAYS=7
STORAGE_CLEANUP_INTERVAL_MS=3600000
PAYMENT_PROVIDER=development
PAYMENT_WEBHOOK_SECRET=
PAYMENT_BASE_URL=
PAYMENT_API_KEY=
PRINTREADY_ADMIN_EMAIL=
